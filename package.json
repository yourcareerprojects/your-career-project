{
  "name": "career-path-explorer",
  "version": "1.0.0",
  "description": "A modern career path exploration tool that helps users discover and plan their professional journey",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"nodemon server.js\" \"webpack serve --mode development\" \"nodemon src/workers/cvExtractionWorker.js\"",
    "dev:server": "nodemon server.js",
    "dev:client": "webpack serve --mode development",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "audit:prod": "npm audit --production",
    "build": "webpack --mode production",
    "build:render": "npm install --include=dev && npm run build",
    "migrate:duplicates": "node scripts/migrateDuplicateCareerSteps.js",
    "build:skills": "node scripts/buildSkillModels.js",
    "build:skills:force": "node scripts/buildSkillModels.js --force",
    "build:skills:dry": "node scripts/buildSkillModels.js --dry-run",
    "build:seniority": "node scripts/buildSeniorityLevels.js",
    "build:seniority:force": "node scripts/buildSeniorityLevels.js --force",
    "build:seniority:dry": "node scripts/buildSeniorityLevels.js --dry-run",
    "build:responsibilities": "node scripts/buildKeyResponsibilities.js",
    "build:responsibilities:force": "node scripts/buildKeyResponsibilities.js --force",
    "build:responsibilities:dry": "node scripts/buildKeyResponsibilities.js --dry-run",
    "build:responsibilities:heuristic": "node scripts/buildKeyResponsibilities.js --heuristic",
    "worker:simulation-jobs": "node scripts/simulationJobWorker.js",
    "worker:cv-extraction": "node src/workers/cvExtractionWorker.js",
    "rebuild:role-embeddings": "node scripts/rebuildRoleEmbeddings.js",
    "rebuild:role-embeddings:dry": "node scripts/rebuildRoleEmbeddings.js --dry-run",
    "migrate:careerpath-translations": "node scripts/migrateCareerPathTranslations.js",
    "migrate:embedded-i18n": "node scripts/migrate-to-embedded-i18n.js",
    "cleanup:legacy-i18n": "node scripts/cleanup-legacy-i18n.js",
    "check:i18n-integrity": "node scripts/check-i18n-integrity.js",
    "drop:legacy-translations": "node scripts/drop-legacy-translations.js",
    "seed:careerpath-translations:de": "node scripts/translateCareerPaths.js",
    "migrate:skills": "node scripts/migrateSkills.js",
    "migrate:skills:dry": "node scripts/migrateSkills.js --dry-run --limit=100",
    "seed:skills:de": "node scripts/translateSkills.js",
    "skills:find-bad": "node scripts/findBadSkills.js",
    "skills:generate-suggestions": "node scripts/generateSkillSuggestions.js",
    "skills:apply-suggestions": "node scripts/applySkillTranslations.js",
    "skills-domains:find-bad": "node scripts/findBadSkillDomains.js",
    "skills-domains:generate-suggestions": "node scripts/generateSkillDomainSuggestions.js",
    "skills-domains:apply-suggestions": "node scripts/applySkillDomainTranslations.js",
    "roles:find-bad-titles": "node scripts/findBadRoleTitles.js",
    "roles:generate-title-suggestions": "node scripts/generateRoleTitleSuggestions.js",
    "roles:apply-title-suggestions": "node scripts/applyRoleTitleTranslations.js",
    "roles:find-bad-descriptions": "node scripts/findBadRoleDescriptions.js",
    "roles:generate-description-suggestions": "node scripts/generateRoleDescriptionSuggestions.js",
    "roles:apply-description-suggestions": "node scripts/applyRoleDescriptionTranslations.js",
    "responsibilities:find-bad": "node scripts/findBadRoleResponsibilities.js",
    "responsibilities:generate-suggestions": "node scripts/generateRoleResponsibilitySuggestions.js",
    "responsibilities:generate-suggestions:sie": "node scripts/generateRoleResponsibilitySuggestions.js --style=sie",
    "responsibilities:apply-suggestions": "node scripts/applyRoleResponsibilityTranslations.js",
    "sync:esco": "node scripts/syncEscoOccupations.js",
    "evaluate": "node evaluation/evaluationRunner.js",
    "evaluate:ranking-tables": "node evaluation/evaluationRankingTables.js --out=evaluation/output/allUserRankingTables_final.md"
  },
  "keywords": [
    "career",
    "path",
    "exploration",
    "planning",
    "professional-development"
  ],
  "author": "Nicola",
  "engines": {
    "node": "20.x"
  },
  "license": "ISC",
  "dependencies": {
    "@babel/register": "^7.29.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.2",
    "@mui/material": "^5.15.2",
    "@napi-rs/canvas": "^0.1.100",
    "axios": "^1.6.5",
    "bcryptjs": "^3.0.2",
    "canvas": "^3.2.3",
    "canvas-confetti": "^1.9.4",
    "compression": "^1.7.4",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "formik": "^2.4.5",
    "helmet": "^7.1.0",
    "i18next": "^26.0.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.3.6",
    "mammoth": "^1.11.0",
    "mongoose": "^8.15.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "openai": "^6.25.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-linkedin-oauth2": "^2.0.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-easy-crop": "^5.5.3",
    "react-i18next": "^17.0.4",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.21.1",
    "socket.io-client": "^4.7.2",
    "tesseract.js": "^7.0.0",
    "winston": "^3.11.0",
    "word-extractor": "^1.0.4",
    "yup": "^1.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@playwright/test": "^1.53.2",
    "babel-loader": "^9.2.1",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "concurrently": "^9.1.2",
    "css-loader": "^6.8.1",
    "dotenv-webpack": "^8.0.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.6",
    "nodemon": "^3.0.3",
    "picocolors": "^1.1.1",
    "style-loader": "^3.3.3",
    "supertest": "^6.3.4",
    "webpack": "^5.106.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "dotenv/config"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/server/tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true,
    "forceExit": true,
    "clearMocks": true,
    "resetMocks": true,
    "restoreMocks": true
  }
}
